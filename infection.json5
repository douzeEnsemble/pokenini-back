{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "@default": true,
        "RoundingFamily": {
            "ignore": [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
        },
        "Division": {
            "ignore": [
                "App\\Helper\\TotalRoundCountHelper::calculate",
                "App\\DTO\\ElectionMetrics::__construct",
            ],
        },
        "Modulus": {
            "ignore": [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
        },
        "CastFloat": {
            "ignore": [
                "App\\Helper\\TotalRoundCountHelper::calculate",
            ],
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                "depth: \\d+,"
            ]
        },
        "MethodCallRemoval": {
            "ignoreSourceCodeByRegex": [
                "\\$this->logger->info.*",
                "\\$this->logger->critical.*",
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                // Equivalent mutant: removing this early return still falls through to the
                // `targetDexSlug` isset() check just below, which rejects the same empty/falsy
                // bodies with the same JsonResponse([], 400) — no externally observable difference.
                "App\\Controller\\Album\\TrainerDexLinkController::create",
                // Equivalent mutant: removing this early return still falls through to
                // `filemtime()` on the now-known-missing path, which itself returns false and
                // is caught by the `false === $mtime` check just below — same null result.
                "App\\Service\\LocalVersionService::getUpdatedAt",
            ],
        },
        "ArrayItem": {
            "ignoreSourceCodeByRegex": [
                "\\$this->logger->info.*",
                "\\$this->logger->critical.*",
            ]
        },
        "global-ignoreSourceCodeByRegex": [
            "\\$query .= <<<'SUBSQL'.*",
        ],
        "global-ignore": [
            "App\\Controller\\Connect\\FakeController::check"
        ]
    },
    "tmpDir": "/app/var/cache/infection",
    "timeout": 30,
    "testFramework": "phpunit",
    "testFrameworkOptions": '--exclude-group="browser-testing"',
    "logs": {
        "text": "/app/build/infection/infection_text.log",
        "summary": "/app/build/infection/infection_summary.log",
    }
}
